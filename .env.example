# Copy to .env.local and fill in. Nothing here is read at build time except
# the NEXT_PUBLIC_* pair, so a missing value shows up as a runtime error in the
# feature that needs it, not as a failed build.
#
# The minimum to get the app running locally is the first two blocks:
# a database and Google sign-in. Everything below those is per-feature.

# ── Database ─────────────────────────────────────────────────────────────────
# Neon (or any Postgres). Run `npm run db:migrate` after setting this.
# Careful in this project: production lives on Neon's `dev` branch, not `main`.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Auth ─────────────────────────────────────────────────────────────────────
# Read by Auth.js itself, not by our code. Generate the secret with:
#   npx auth secret
AUTH_SECRET=
# From Google Cloud Console. Walkthrough: docs/GOOGLE_SETUP.md
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Only needed if the deployment URL can't be inferred (Vercel sets it for you).
# AUTH_URL=http://localhost:3000

# ── Google Calendar ──────────────────────────────────────────────────────────
# No extra keys: the same OAuth pair above carries the Calendar scopes, and the
# refresh token is stored per-account by the Auth.js adapter. Used to build the
# event's back-link to the app.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Push notifications ───────────────────────────────────────────────────────
# Generate a VAPID pair with:  npx web-push generate-vapid-keys
# The public key goes in twice on purpose: the browser needs it to subscribe
# (NEXT_PUBLIC_*, so it's bundled) and the cron needs it to sign (server-only).
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ── Cron ─────────────────────────────────────────────────────────────────────
# Any long random string. The cron routes REJECT every request when this is
# unset — they fail closed on purpose, so leaving it empty disables them rather
# than opening them to the internet. Vercel Cron sends it as `x-cron-secret`.
CRON_SECRET=

# ── File uploads ─────────────────────────────────────────────────────────────
# Task attachments and avatars. Read by @vercel/blob from the environment, so
# it never appears in our source. `vercel env pull` fills it in automatically.
BLOB_READ_WRITE_TOKEN=

# ── Spotify (optional) ───────────────────────────────────────────────────────
# Only for playback on the Focus screen. The app works fine without it — the
# Spotify tab just stays disconnected. Needs a Premium account to play.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
